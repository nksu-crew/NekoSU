# The nksu kernel module is compiled by kbuild, which Bazel invokes as a
# non-hermetic action (see bazel/nksu.bzl). Forward the environment that the
# DDK container (ghcr.io/ylarod/ddk) exports into those actions.
build --action_env=KDIR
build --action_env=KERNEL_SRC
build --action_env=PATH
build --action_env=ARCH
build --action_env=CROSS_COMPILE
build --action_env=LLVM
build --action_env=LLVM_IAS
build --action_env=CLANG_PATH
build --action_env=LIBCLANG_PATH

build --verbose_failures

# No external dependencies are used, so skip the lockfile entirely.
common --lockfile_mode=off
